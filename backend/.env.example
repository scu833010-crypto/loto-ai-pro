PORT=3000
NODE_ENV=production
# Ruta local SQLite. En producción persistente configure un volumen para esta ruta.
DATABASE_PATH=./data.sqlite
# Alternativa para una base administrada, si el adaptador correspondiente se incorpora en el futuro.
DATABASE_URL=
CACHE_TTL_SECONDS=120
RATE_LIMIT_PER_MINUTE=60
ADMIN_API_KEY=change-this-in-production
CORS_ORIGINS=https://your-app.example
# Fuente pública de resultados (sin credenciales requeridas actualmente).
RESULTS_API_URL=https://api.loteriasdominicanas.com/dominicana/sessions
# Si el proveedor exige autenticación en el futuro, configurar solo en el backend.
RESULTS_API_KEY=
